{
  "name": "@barney-media/utils-typescript",
  "version": "0.0.1",
  "description": "TypeScript utility classes for converting storage and transfer units across byte- and bit-based scales.",
  "license": "Apache-2.0",
  "author": "Fabian Barney",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "npm@11.15.0",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabian-barney/utils-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/fabian-barney/utils-typescript/issues"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "crap-typescript-check": "vitest run --config vitest.crap.config.ts",
    "cognitive-typescript-check": "node ./scripts/run-cognitive-typescript-gate.mjs src",
    "prepack": "npm run build",
    "test": "vitest run --coverage.enabled true",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@barney-media/crap-typescript-vitest": "^0.4.2",
    "@vitest/coverage-v8": "^4.1.10",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
