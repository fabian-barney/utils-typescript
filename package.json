{
  "name": "@barney-media/utils-typescript",
  "version": "0.0.1",
  "description": "TypeScript utility classes for converting storage and transfer units across byte- and bit-based scales.",
  "license": "Apache-2.0",
  "author": "Fabian Barney",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabian-barney/utils-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/fabian-barney/utils-typescript/issues"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --json --dry-run --ignore-scripts",
    "verify": "npm run typecheck && npm run test && npm run build",
    "quality-gate": "npm run typecheck && npm run build && npm run pack:check"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  }
}
